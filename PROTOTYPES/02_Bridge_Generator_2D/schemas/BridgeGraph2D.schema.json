{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robo-bridge.local/schemas/BridgeGraph2D.schema.json",
  "title": "BridgeGraph2D",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "members", "cables", "metadata"],
  "properties": {
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "members": { "type": "array", "items": { "$ref": "#/$defs/member" } },
    "cables": { "type": "array", "items": { "$ref": "#/$defs/cable" } },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "generatorVersion", "family", "span", "bridgeWidth", "vehicleClearance", "sideStructures", "sharedDeck", "designRevision", "deterministicChecksum"],
      "properties": {
        "version": { "const": 3 }, "generatorVersion": { "type": "integer" },
        "family": { "type": "string" }, "span": { "type": "number" }, "bridgeWidth": { "type": "number" },
        "vehicleClearance": { "type": "number" }, "sideStructures": { "type": "integer" }, "sharedDeck": { "type": "boolean" },
        "designRevision": { "type": "integer", "minimum": 0 }, "deterministicChecksum": { "type": "string", "pattern": "^[0-9A-F]{8}$" }
      }
    }
  },
  "$defs": {
    "point": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
    "node": {
      "type": "object", "required": ["id", "x", "y", "role", "supportType"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 }, "x": { "type": "number" }, "y": { "type": "number" },
        "role": { "enum": ["support", "deck", "pier", "tower", "joint", "anchor"] },
        "supportType": { "enum": ["fixed", "terrain", "none"] }, "side": { "enum": ["near", "far"] }, "cableAttachment": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "member": {
      "type": "object", "required": ["id", "nodeA", "nodeB", "role", "memberClass", "capacityClass"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 }, "nodeA": { "type": "integer", "minimum": 1 }, "nodeB": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["beam", "chord", "diagonal", "vertical", "pier", "arch", "deck", "tower"] },
        "memberClass": { "type": "string", "minLength": 1 }, "capacityClass": { "type": "integer", "minimum": 1, "maximum": 6 },
        "side": { "enum": ["near", "far"] }
      },
      "additionalProperties": false
    },
    "cable": {
      "type": "object", "required": ["id", "anchorNodeA", "anchorNodeB", "structuralRole", "breakable", "samples", "hangerTargets"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 }, "anchorNodeA": { "type": "integer", "minimum": 1 }, "anchorNodeB": { "type": "integer", "minimum": 1 },
        "structuralRole": { "enum": ["main", "stay", "hanger", "decorative"] }, "breakable": { "type": "boolean" },
        "samples": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/point" } },
        "hangerTargets": { "type": "array", "items": { "$ref": "#/$defs/point" } },
        "sag": { "type": "number" }, "parentCableId": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
