{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robo-bridge.local/schemas/BridgeSpec.schema.json",
  "title": "Brick-ready BridgeSpec",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/beam" },
    { "$ref": "#/$defs/pier" },
    { "$ref": "#/$defs/arch" },
    { "$ref": "#/$defs/viaduct" },
    { "$ref": "#/$defs/corbelled" },
    { "$ref": "#/$defs/boxCulvert" },
    { "$ref": "#/$defs/trestle" },
    { "$ref": "#/$defs/warren" },
    { "$ref": "#/$defs/pratt" },
    { "$ref": "#/$defs/howe" },
    { "$ref": "#/$defs/tiedArch" },
    { "$ref": "#/$defs/suspension" },
    { "$ref": "#/$defs/bascule" }
  ],
  "$defs": {
    "brick": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed", "maxBeamStuds", "sideThicknessStuds", "deckThicknessLayers",
        "bondPattern", "studSize", "layerHeight"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "brick-2x4", "brick-2x2", "brick-1x4", "brick-1x2", "brick-1x1", "arch-wedge",
              "technic-beam", "technic-connector", "cable", "chain", "hinge"
            ]
          }
        },
        "maxBeamStuds": { "type": "integer", "minimum": 4, "maximum": 80 },
        "sideThicknessStuds": { "type": "integer", "minimum": 1, "maximum": 8 },
        "deckThicknessLayers": { "type": "integer", "minimum": 1, "maximum": 8 },
        "bondPattern": { "enum": ["running", "stack"] },
        "studSize": { "enum": [0.5, 1, 2] },
        "layerHeight": { "enum": [0.5, 1, 2] }
      }
    },
    "common": {
      "type": "object",
      "required": [
        "version", "family", "seed", "span", "deckHeight", "bridgeWidth", "vehicleClearance",
        "symmetry", "structuralDensity", "targetLoadClass", "brick"
      ],
      "properties": {
        "version": { "const": 3 },
        "family": {
          "enum": [
            "beam", "pier", "arch", "viaduct", "corbelled", "boxCulvert",
            "trestle", "warren", "pratt", "howe", "tiedArch", "suspension", "bascule"
          ]
        },
        "seed": { "type": "integer" },
        "span": { "type": "number", "exclusiveMinimum": 0, "maximum": 180 },
        "deckHeight": { "type": "number", "minimum": -10, "maximum": 80 },
        "bridgeWidth": { "type": "number", "minimum": 4, "maximum": 30 },
        "vehicleClearance": { "type": "number", "minimum": 2, "maximum": 20 },
        "symmetry": { "type": "boolean" },
        "structuralDensity": { "type": "number", "minimum": 0.2, "maximum": 1 },
        "targetLoadClass": { "type": "integer", "minimum": 1, "maximum": 5 },
        "brick": { "$ref": "#/$defs/brick" }
      }
    },
    "beam": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["panelCount"],
          "properties": {
            "family": { "const": "beam" },
            "panelCount": { "type": "integer", "minimum": 2, "maximum": 32 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "pier": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["panelCount", "pierCount", "pierSpacing"],
          "properties": {
            "family": { "const": "pier" },
            "panelCount": { "type": "integer", "minimum": 2, "maximum": 32 },
            "pierCount": { "type": "integer", "minimum": 1, "maximum": 12 },
            "pierSpacing": { "type": "number", "minimum": 4, "maximum": 40 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "trestle": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["panelCount", "pierCount", "pierSpacing", "crossBracing"],
          "properties": {
            "family": { "const": "trestle" },
            "panelCount": { "type": "integer", "minimum": 2, "maximum": 32 },
            "pierCount": { "type": "integer", "minimum": 1, "maximum": 12 },
            "pierSpacing": { "type": "number", "minimum": 4, "maximum": 40 },
            "crossBracing": { "type": "boolean" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "truss": {
      "type": "object",
      "required": ["panelCount", "trussHeight", "crossBracing"],
      "properties": {
        "panelCount": { "type": "integer", "minimum": 2, "maximum": 32 },
        "trussHeight": { "type": "number", "minimum": 4, "maximum": 50 },
        "crossBracing": { "type": "boolean" }
      }
    },
    "warren": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/common" },
        { "$ref": "#/$defs/truss" },
        { "type": "object", "properties": { "family": { "const": "warren" } } }
      ],
      "unevaluatedProperties": false
    },
    "pratt": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/common" },
        { "$ref": "#/$defs/truss" },
        { "type": "object", "properties": { "family": { "const": "pratt" } } }
      ],
      "unevaluatedProperties": false
    },
    "howe": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/common" },
        { "$ref": "#/$defs/truss" },
        { "type": "object", "properties": { "family": { "const": "howe" } } }
      ],
      "unevaluatedProperties": false
    },
    "arch": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["panelCount", "archShape", "archRise"],
          "properties": {
            "family": { "const": "arch" },
            "panelCount": { "type": "integer", "minimum": 2, "maximum": 32 },
            "archShape": { "enum": ["segmental", "elliptical"] },
            "archRise": { "type": "number", "minimum": 4, "maximum": 48 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "viaduct": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["archCount", "archShape", "archRise"],
          "properties": {
            "family": { "const": "viaduct" },
            "archCount": { "type": "integer", "minimum": 1, "maximum": 12 },
            "archShape": { "enum": ["segmental", "elliptical"] },
            "archRise": { "type": "number", "minimum": 4, "maximum": 48 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "corbelled": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["archRise"],
          "properties": {
            "family": { "const": "corbelled" },
            "archRise": { "type": "number", "minimum": 4, "maximum": 48 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "boxCulvert": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["panelCount"],
          "properties": {
            "family": { "const": "boxCulvert" },
            "panelCount": { "type": "integer", "minimum": 2, "maximum": 32 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "tiedArch": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["panelCount", "trussHeight", "hangerSpacing", "crossBracing"],
          "properties": {
            "family": { "const": "tiedArch" },
            "panelCount": { "type": "integer", "minimum": 2, "maximum": 32 },
            "trussHeight": { "type": "number", "minimum": 4, "maximum": 50 },
            "hangerSpacing": { "type": "number", "minimum": 2, "maximum": 24 },
            "crossBracing": { "type": "boolean" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "suspension": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["panelCount", "towerHeight", "cableSag", "hangerSpacing"],
          "properties": {
            "family": { "const": "suspension" },
            "panelCount": { "type": "integer", "minimum": 2, "maximum": 32 },
            "towerHeight": { "type": "number", "minimum": 8, "maximum": 50 },
            "cableSag": { "type": "number", "minimum": 2, "maximum": 30 },
            "hangerSpacing": { "type": "number", "minimum": 2, "maximum": 24 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "bascule": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["panelCount", "towerHeight"],
          "properties": {
            "family": { "const": "bascule" },
            "panelCount": { "type": "integer", "minimum": 4, "maximum": 32 },
            "towerHeight": { "type": "number", "minimum": 8, "maximum": 50 }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
