{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robo-bridge.local/schemas/BridgeSpec.schema.json",
  "title": "Brick-ready BridgeSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "family", "seed", "span", "deckHeight", "bridgeWidth", "vehicleClearance",
    "symmetry", "structuralDensity", "targetLoadClass", "brick"
  ],
  "properties": {
    "version": { "const": 3 },
    "family": {
      "enum": [
        "beam", "pier", "arch", "viaduct", "corbelled", "boxCulvert",
        "trestle", "warren", "pratt", "howe", "tiedArch", "suspension", "bascule"
      ]
    },
    "seed": { "type": "integer" },
    "span": { "type": "number", "exclusiveMinimum": 0, "maximum": 180 },
    "deckHeight": { "type": "number", "minimum": -10, "maximum": 80 },
    "bridgeWidth": { "type": "number", "minimum": 4, "maximum": 30 },
    "vehicleClearance": { "type": "number", "minimum": 2, "maximum": 20 },
    "panelCount": { "type": "integer", "minimum": 2, "maximum": 32 },
    "trussHeight": { "type": "number", "minimum": 4, "maximum": 50 },
    "pierCount": { "type": "integer", "minimum": 0, "maximum": 12 },
    "pierSpacing": { "type": "number", "minimum": 4, "maximum": 40 },
    "archCount": { "type": "integer", "minimum": 1, "maximum": 12 },
    "archShape": { "enum": ["segmental", "elliptical"] },
    "archRise": { "type": "number", "minimum": 4, "maximum": 48 },
    "towerHeight": { "type": "number", "minimum": 8, "maximum": 50 },
    "cableSag": { "type": "number", "minimum": 2, "maximum": 30 },
    "hangerSpacing": { "type": "number", "minimum": 2, "maximum": 24 },
    "symmetry": { "type": "boolean" },
    "crossBracing": { "type": "boolean" },
    "structuralDensity": { "type": "number", "minimum": 0.2, "maximum": 1 },
    "targetLoadClass": { "type": "integer", "minimum": 1, "maximum": 5 },
    "brick": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed", "maxBeamStuds", "sideThicknessStuds", "deckThicknessLayers",
        "bondPattern", "studSize", "layerHeight"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "brick-2x4", "brick-2x2", "brick-1x4", "brick-1x2", "brick-1x1", "arch-wedge",
              "technic-beam", "technic-connector", "cable", "chain", "hinge"
            ]
          }
        },
        "maxBeamStuds": { "type": "integer", "minimum": 4, "maximum": 80 },
        "sideThicknessStuds": { "type": "integer", "minimum": 1, "maximum": 8 },
        "deckThicknessLayers": { "type": "integer", "minimum": 1, "maximum": 8 },
        "bondPattern": { "enum": ["running", "stack"] },
        "studSize": { "enum": [0.5, 1, 2] },
        "layerHeight": { "enum": [0.5, 1, 2] }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "family": { "enum": ["beam", "pier"] } } }, "then": { "required": ["panelCount", "pierCount", "pierSpacing"] } },
    { "if": { "properties": { "family": { "const": "trestle" } } }, "then": { "required": ["panelCount", "pierCount", "pierSpacing", "crossBracing"] } },
    { "if": { "properties": { "family": { "enum": ["warren", "pratt", "howe"] } } }, "then": { "required": ["panelCount", "trussHeight", "crossBracing"] } },
    { "if": { "properties": { "family": { "const": "arch" } } }, "then": { "required": ["panelCount", "archShape", "archRise"] } },
    { "if": { "properties": { "family": { "const": "viaduct" } } }, "then": { "required": ["archCount", "archShape", "archRise"] } },
    { "if": { "properties": { "family": { "const": "corbelled" } } }, "then": { "required": ["archRise"] } },
    { "if": { "properties": { "family": { "const": "boxCulvert" } } }, "then": { "required": ["panelCount"] } },
    { "if": { "properties": { "family": { "const": "tiedArch" } } }, "then": { "required": ["panelCount", "trussHeight", "hangerSpacing", "crossBracing"] } },
    { "if": { "properties": { "family": { "const": "suspension" } } }, "then": { "required": ["panelCount", "towerHeight", "cableSag", "hangerSpacing"] } },
    { "if": { "properties": { "family": { "const": "bascule" } } }, "then": { "required": ["panelCount", "towerHeight"] } }
  ]
}
