{
  "name": "robo-bridge-mcp",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve:web": "python scripts/serve_web.py",
    "test:js": "node --test --test-concurrency=1 tests/js/*.test.js",
    "test:robot": "node --test --test-concurrency=1 tests/js/robot-*.test.js tests/js/collision.test.js tests/js/board-runtime.test.js",
    "test:webmcp": "node --test --test-concurrency=1 tests/js/webmcp.test.js tests/js/perception.test.js tests/js/production-round.test.js",
    "test:compiler": "node --test --test-concurrency=1 tests/js/logo-*.test.js tests/js/compiler-integration.test.js",
    "test:player": "node --test tests/js/main-demo-player.test.js",
    "test:reliability": "node scripts/reliability.mjs",
    "verify": "python scripts/verify.py",
    "build:release": "python scripts/build_release.py",
    "test:submission": "node --test --test-concurrency=1 tests/js/submission-gate.test.js",
    "construction:player-browser": "node scripts/construction-player-browser.mjs",
    "simple:browser": "node scripts/simple-webmcp-browser.mjs --write-evidence",
    "level1:browser": "node scripts/level1-launch-browser.mjs",
    "submission:gate": "node tools/submission/submission-gate.mjs",
    "submission:smoke": "node tools/submission/submission-gate.mjs --smoke --hero-attempts 1 --reset-cycles 3",
    "webmcp:audit": "node tools/submission/submission-gate.mjs --browser-only --catalogue minimum --hero-attempts 0 --reset-cycles 1 --output artifacts/submission-evidence/webmcp-audit",
    "hero:1": "node tools/submission/hero-runner.mjs 1",
    "hero:3": "node tools/submission/hero-runner.mjs 3",
    "hero:10": "node tools/submission/hero-runner.mjs 10",
    "release:evidence": "node tools/submission/submission-gate.mjs --profile final --hero-attempts 10 --reset-cycles 50"
  },
  "engines": {
    "node": ">=20",
    "python": ">=3.10"
  }
}
